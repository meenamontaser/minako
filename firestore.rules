rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ← حط هنا إيميل/إيميلات الأدمن بتاعة الشركة (نفس اللي عملته في Authentication)
    function isAdmin() {
      return request.auth != null
          && request.auth.token.email in ['admin@company.com'];
    }

    match /listings/{id} { allow read: if true; allow write: if isAdmin(); }
    match /media/{id}    { allow read: if true; allow write: if isAdmin(); }
    match /vchunks/{id}  { allow read: if true; allow write: if isAdmin(); }
    match /settings/{id} { allow read: if true; allow write: if isAdmin(); }
  }
}
